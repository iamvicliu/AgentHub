{
  "name": "@spool-lab/session-kit",
  "version": "0.6.3",
  "private": true,
  "description": "Browser-safe canonical records, sequence hashing, edit extraction, views, and Session diffs for Spool.",
  "homepage": "https://github.com/spool-lab/spool#readme",
  "bugs": {
    "url": "https://github.com/spool-lab/spool/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spool-lab/spool.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "vp run build"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
